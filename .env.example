# API Configuration
# The admin calls the API's /dashboard routes — not /api, which is the
# public-facing prefix. utils/api.js appends each endpoint to this value.
VITE_API_URL=http://localhost:5001/dashboard

# Cloudinary — banner image uploads in the Blog section
VITE_CLAUDINARY_CLOUD=
VITE_CLAUDINARY_PRESET=

# Development Settings
NODE_ENV=development
PORT=3000

# Add other environment variables as needed
# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
